# 留空时自动下载 GitHub 最新 Release 中匹配当前操作系统和 CPU 架构的程序包并校验 SHA-256。
# 需要固定来源时，可在此填写原始可执行文件的下载地址。
OPENRESTY_PLUS_BINARY_URL=
OPENRESTY_PLUS_BINARY_PATH=bin/openresty-plus

OPENRESTY_HTTP_ADDR=:8081
OPENRESTY_DB_URL=jdbc:mysql://127.0.0.1:3306/openresty-plus?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
OPENRESTY_DB_USERNAME=openresty-plus
OPENRESTY_DB_PASSWORD=replace-with-mysql-password

OPENRESTY_REDIS_ADDR=127.0.0.1:6379
OPENRESTY_REDIS_PASSWORD=
OPENRESTY_REDIS_DB=0

OPENRESTY_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
OPENRESTY_KAFKA_TOPIC=dtl-602-openresty-plus
OPENRESTY_KAFKA_CONSUMER_GROUP=openresty-plus-control-plane-v1

OPENRESTY_ADMIN_USERNAME=admin
OPENRESTY_ADMIN_PASSWORD=replace-with-admin-password
# Compose 风格变量 ADMIN_USERNAME/ADMIN_PASSWORD 也可使用；若两组都填写，OPENRESTY_* 优先。
# 运行 openssl rand -hex 32 生成。复用数据库时必须保持该值不变。
OPENRESTY_DATA_KEY=
