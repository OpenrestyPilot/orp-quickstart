# 留空时自动下载 GitHub 最新 Release 中匹配当前操作系统和 CPU 架构的程序包并校验 SHA-256。
# 需要固定来源时，可在此填写原始可执行文件的下载地址。
ORP_BINARY_URL=
ORP_BINARY_PATH=bin/orp

ORP_HTTP_ADDR=:8081
ORP_AGENT_PUBLIC_URL=
ORP_DB_URL=jdbc:mysql://127.0.0.1:3306/orp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
ORP_DB_USERNAME=orp
ORP_DB_PASSWORD=replace-with-mysql-password

ORP_REDIS_ADDR=127.0.0.1:6379
ORP_REDIS_PASSWORD=
ORP_REDIS_DB=0

ORP_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
ORP_KAFKA_TOPIC=orp-access-logs
ORP_KAFKA_CONSUMER_GROUP=orp-control-plane-v1

ORP_ADMIN_USERNAME=admin
ORP_ADMIN_PASSWORD=replace-with-admin-password
# 登录页滑块验证码开关，默认关闭；设为 true 开启。
ORP_CAPTCHA_ENABLED=false
# Compose 风格变量 ORP_ADMIN_USERNAME/ORP_ADMIN_PASSWORD 也可使用；若两组都填写，ORP_* 优先。
# 运行 openssl rand -hex 32 生成。复用数据库时必须保持该值不变。
ORP_DATA_KEY=
