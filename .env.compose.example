IMAGE_TAG=latest
ORP_IMAGE=registry.gitlab.com/openrestyplus/openresty-plus
RUNTIME_IMAGE=registry.gitlab.com/openrestyplus/orp-quickstart/openresty
FILEBEAT_IMAGE=registry.gitlab.com/openrestyplus/orp-quickstart/filebeat
IMPORTER_IMAGE=registry.gitlab.com/openrestyplus/orp-nginx-importer
ORP_ADMIN_USERNAME=admin
ORP_ADMIN_PASSWORD=replace-with-generated-password
ORP_CAPTCHA_ENABLED=false
ORP_DATA_KEY=replace-with-64-hex-character-key
ORP_HTTP_ADDR=:8081
ORP_AGENT_PUBLIC_URL=
ORP_DB_URL=jdbc:mysql://127.0.0.1:3306/orp?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai
ORP_DB_USERNAME=orp
ORP_DB_PASSWORD=replace-with-mysql-password
ORP_REDIS_ADDR=127.0.0.1:6379
ORP_REDIS_PASSWORD=
ORP_REDIS_DB=0
ORP_KAFKA_BOOTSTRAP_SERVERS=127.0.0.1:9092
ORP_KAFKA_TOPIC=orp-access-logs
ORP_KAFKA_CONSUMER_GROUP=orp-control-plane-v1
# 演示模式 Filebeat 使用 YAML/JSON 列表，可填写多个 broker。
FILEBEAT_KAFKA_HOSTS='["127.0.0.1:9092"]'
# 以下仅适用于开启演示 Filebeat 的场景。生产 Kafka 应先确认 topic 副本数和 min.insync.replicas，再将确认级别设为 -1。
FILEBEAT_KAFKA_REQUIRED_ACKS=1
FILEBEAT_DISK_QUEUE_MAX_SIZE=1GB
QUICKSTART_START_DEMOS=false
# Quickstart 会在准备演示中心后自动写入 UUID，请勿手动填写。
QUICKSTART_RUNTIME_CENTER_ID=
# 设为 true 可同时启动三个演示节点及持续请求生成容器。
QUICKSTART_START_TRAFFIC_GENERATOR=false
TRAFFIC_REQUEST_INTERVAL_SECONDS=0.5
TRAFFIC_REQUEST_TIMEOUT_SECONDS=3
FILEBEAT_EAST_1_NODE_ID=
FILEBEAT_EAST_2_NODE_ID=
FILEBEAT_EAST_3_NODE_ID=
